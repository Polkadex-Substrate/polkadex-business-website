/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000

# Hashed Next.js build assets — content-hashed filenames, safe to cache forever
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts — filenames are stable, cache for a year
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images and other static media — cache a week, revalidate after
/img/*
  Cache-Control: public, max-age=604800, must-revalidate

# Downloadable media kit assets
/mediaKit/*
  Cache-Control: public, max-age=604800, must-revalidate

# HTML pages — cache at the edge but always revalidate so deploys show fast
/*
  Cache-Control: public, max-age=0, s-maxage=3600, must-revalidate
